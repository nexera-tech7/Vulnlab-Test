<% const title = 'SQL Injection Lab' %>
<%- include('../partials/head') %>

<div class="lab-page">
  <div class="lab-header">
    <div class="breadcrumb"><a href="/">Dashboard</a> / SQL Injection</div>
    <h1>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/></svg>
      SQL Injection
    </h1>
    <p class="desc">Inject malicious SQL through unsanitized user input. The vulnerable version concatenates user input directly into SQL queries, allowing you to manipulate the query logic.</p>
  </div>

  <div class="mode-toggle">
    <button data-mode="vulnerable" class="active" onclick="setMode('vulnerable')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
      Vulnerable
    </button>
    <button data-mode="fixed" onclick="setMode('fixed')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      Fixed
    </button>
  </div>

  <div class="info-box">
    <h3>What to try</h3>
    <ul>
      <li>Search for a normal username like <strong>admin</strong></li>
      <li>Try <code>' OR '1'='1</code> to dump all users</li>
      <li>Try <code>' UNION SELECT 1,sql,3,4,5 FROM sqlite_master--</code> to extract schema</li>
      <li>Switch to Fixed mode and try the same payloads</li>
    </ul>
  </div>

  <form method="POST" action="/labs/sqli">
    <input type="hidden" name="mode" id="mode-input" value="vulnerable">
    <div class="form-group">
      <label>Search Users</label>
      <input type="text" name="search" placeholder="Enter username to search..." value="<%= query %>">
    </div>
    <button type="submit" class="btn btn-primary">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      Search
    </button>
  </form>

  <% if (sqlQuery) { %>
    <div class="sql-display"><strong>Executed SQL:</strong> <%= sqlQuery %></div>
  <% } %>

  <% if (error) { %>
    <div class="alert alert-danger" style="margin-top: 16px"><strong>SQL Error:</strong> <%= error %></div>
  <% } %>

  <% if (results && results.length > 0) { %>
    <div class="result-box" style="margin-top: 16px">
      <h4>Results (<%= results.length %> rows)</h4>
      <div style="overflow-x:auto">
        <table>
          <tr>
            <% Object.keys(results[0]).forEach(col => { %>
              <th><%= col %></th>
            <% }) %>
          </tr>
          <% results.forEach(row => { %>
            <tr>
              <% Object.values(row).forEach(val => { %>
                <td><%= val %></td>
              <% }) %>
            </tr>
          <% }) %>
        </table>
      </div>
    </div>
  <% } else if (results && results.length === 0) { %>
    <div class="alert alert-warning" style="margin-top: 16px">No results found.</div>
  <% } %>

  <div class="exploit-panel">
    <h3>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      Sample Payloads
    </h3>
    <div class="payload-item">
      <div>
        <code>' OR '1'='1</code>
        <div class="desc">Dump all users</div>
      </div>
      <button class="copy-btn" onclick="copyPayload(`' OR '1'='1`, this)">Copy</button>
    </div>
    <div class="payload-item">
      <div>
        <code>' UNION SELECT 1,sql,3,4,5 FROM sqlite_master--</code>
        <div class="desc">Extract schema</div>
      </div>
      <button class="copy-btn" onclick="copyPayload(`' UNION SELECT 1,sql,3,4,5 FROM sqlite_master--`, this)">Copy</button>
    </div>
    <div class="payload-item">
      <div>
        <code>' UNION SELECT 1,username,password,email,role FROM users--</code>
        <div class="desc">Extract credentials</div>
      </div>
      <button class="copy-btn" onclick="copyPayload(`' UNION SELECT 1,username,password,email,role FROM users--`, this)">Copy</button>
    </div>
  </div>

  <div class="code-compare">
    <div class="code-block">
      <div class="code-header vuln">Vulnerable Code</div>
      <pre><span class="comment">// String concatenation - NEVER do this</span>
<span class="keyword">const</span> sql = <span class="string">`SELECT * FROM users
  WHERE username LIKE '%<span class="highlight">${search}</span>%'`</span>;
db.exec(sql);</pre>
    </div>
    <div class="code-block">
      <div class="code-header safe">Fixed Code</div>
      <pre><span class="comment">// Parameterized query - safe</span>
<span class="keyword">const</span> stmt = db.prepare(
  <span class="string">"SELECT id, username, email, role
   FROM users WHERE username LIKE <span class="safe-hl">?</span>"</span>
);
stmt.bind([<span class="safe-hl">`%${search}%`</span>]);</pre>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
