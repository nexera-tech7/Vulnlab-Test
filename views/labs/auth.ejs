<% const title = 'Broken Authentication Lab' %>
<%- include('../partials/head') %>

<div class="lab-page">
  <div class="lab-header">
    <div class="breadcrumb"><a href="/">Dashboard</a> / Broken Authentication</div>
    <h1>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 7-6.5 6.5a1.5 1.5 0 0 0 3 3L18 10"/><path d="m2.5 21.5 3-3"/><path d="m18 2-4 4"/><path d="m2 6 4-4"/><path d="m21.5 21.5-3-3"/></svg>
      Broken Authentication
    </h1>
    <p class="desc">Exploit multiple authentication weaknesses: plaintext password storage, user enumeration through verbose error messages, SQL injection on the login form, and insecure session configuration.</p>
  </div>

  <div class="mode-toggle">
    <button data-mode="vulnerable" class="active" onclick="setMode('vulnerable')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
      Vulnerable
    </button>
    <button data-mode="fixed" onclick="setMode('fixed')">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      Fixed
    </button>
  </div>

  <div class="info-box">
    <h3>What to try</h3>
    <ul>
      <li>Try username <strong>admin</strong> with wrong password &mdash; notice the specific error</li>
      <li>Try username <strong>nonexistent</strong> &mdash; notice a different error (user enumeration)</li>
      <li>SQLi bypass: username <code>admin' --</code> with any password</li>
      <li>SQLi bypass: username <code>' OR 1=1 --</code> with any password</li>
    </ul>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <% if (user) { %>
    <div class="alert alert-success">
      Logged in as <strong><%= user.username %></strong> (role: <%= user.role %>)
      &mdash; <a href="/auth/logout" style="color: var(--accent)">Logout</a>
    </div>
  <% } %>

  <form method="POST" action="/auth/login">
    <input type="hidden" name="mode" id="mode-input" value="vulnerable">
    <div class="form-group">
      <label>Username</label>
      <input type="text" name="username" placeholder="admin" autocomplete="off">
    </div>
    <div class="form-group">
      <label>Password</label>
      <input type="password" name="password" placeholder="admin123" autocomplete="off">
    </div>
    <button type="submit" class="btn btn-primary">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      Login
    </button>
  </form>

  <div class="exploit-panel" style="margin-top: 22px">
    <h3>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      Authentication Flaws
    </h3>
    <div class="payload-item">
      <div>
        <code>admin' --</code>
        <div class="desc">Comment out password check</div>
      </div>
      <button class="copy-btn" onclick="copyPayload(`admin' --`, this)">Copy</button>
    </div>
    <div class="payload-item">
      <div>
        <code>' OR 1=1 --</code>
        <div class="desc">Always-true login bypass</div>
      </div>
      <button class="copy-btn" onclick="copyPayload(`' OR 1=1 --`, this)">Copy</button>
    </div>
    <div class="payload-item">
      <div>
        <strong style="color: var(--text-secondary)">Passwords stored in plaintext</strong>
        <div class="desc">admin123, password1, letmein, qwerty</div>
      </div>
    </div>
  </div>

  <div class="code-compare" style="margin-top: 22px">
    <div class="code-block">
      <div class="code-header vuln">Vulnerable</div>
      <pre><span class="comment">// Plaintext passwords</span>
<span class="comment">// User enumeration via error messages</span>
<span class="keyword">const</span> sql = <span class="string">`SELECT * FROM users
  WHERE username='<span class="highlight">${username}</span>'
  AND password='<span class="highlight">${password}</span>'`</span>;

<span class="comment">// Verbose errors</span>
<span class="highlight">if (userExists)
  "Wrong password for this account"
else
  "No account with that username"</span>

<span class="comment">// Password stored in session</span>
req.session.user = { <span class="highlight">password</span>: ... };</pre>
    </div>
    <div class="code-block">
      <div class="code-header safe">Fixed</div>
      <pre><span class="comment">// Parameterized queries</span>
<span class="keyword">const</span> stmt = db.prepare(
  <span class="string">"SELECT * FROM users
   WHERE username=<span class="safe-hl">?</span> AND password=<span class="safe-hl">?</span>"</span>
);
stmt.bind([username, password]);

<span class="comment">// Generic error message</span>
<span class="safe-hl">"Invalid credentials"</span>

<span class="comment">// No password in session</span>
req.session.user = { id, username, role };
<span class="comment">// cookie.httpOnly = true</span></pre>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
